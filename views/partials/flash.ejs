<!-- Flash Messages -->
<% if (success && success.length) { %>
  <% success.forEach(msg => { %>
    <div class="alert alert-success"><i data-lucide="check-circle"></i> <%= msg %></div>
  <% }) %>
<% } %>
<% if (error && error.length) { %>
  <% error.forEach(msg => { %>
    <div class="alert alert-error"><i data-lucide="alert-circle"></i> <%= msg %></div>
  <% }) %>
<% } %>
