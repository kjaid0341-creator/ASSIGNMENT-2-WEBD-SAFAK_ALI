<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <div class="top-bar">
      <div>
        <div class="page-title">My account</div>
        <div class="breadcrumb">Member overview &mdash; <%= member.name %></div>
      </div>
      <a href="/member/loans/request" class="btn btn-primary btn-sm">
        <i data-lucide="plus"></i> Request loan
      </a>
    </div>

    <div class="page-content">
      <%- include('../partials/flash') %>

      <!-- Group notice -->
      <% if (member.groupId) { %>
      <div class="alert alert-info mb-5" style="margin-bottom:18px">
        <i data-lucide="info"></i>
        Member of <strong><%= member.groupId.name %></strong> &middot; Interest rate: <strong><%= member.groupId.interestRate %>% p.a.</strong>
      </div>
      <% } else { %>
      <div class="alert alert-warning mb-5" style="margin-bottom:18px">
        <i data-lucide="alert-triangle"></i>
        You are not assigned to a group yet. Contact your group admin.
      </div>
      <% } %>

      <!-- Stat bar -->
      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-label">Total savings</div>
          <div class="stat-value rupee">₹<%= stats.totalSavings %></div>
          <div class="stat-sub">All contributions</div>
        </div>
        <div class="stat-item">
          <div class="stat-label">Total borrowed</div>
          <div class="stat-value rupee">₹<%= stats.totalBorrowed %></div>
          <div class="stat-sub"><%= stats.activeLoans %> active loan<%= stats.activeLoans !== 1 ? 's' : '' %></div>
        </div>
        <div class="stat-item">
          <div class="stat-label">Repaid</div>
          <div class="stat-value stat-accent rupee">₹<%= stats.totalRepaid %></div>
          <div class="stat-sub">Payments made</div>
        </div>
        <div class="stat-item">
          <div class="stat-label">Outstanding</div>
          <div class="stat-value stat-warning rupee">₹<%= stats.totalOutstanding %></div>
          <div class="stat-sub"><%= stats.pendingLoans %> pending request<%= stats.pendingLoans !== 1 ? 's' : '' %></div>
        </div>
      </div>

      <div class="flex gap-4" style="flex-wrap:wrap;align-items:flex-start">

        <!-- Recent savings -->
        <div class="card" style="flex:1;min-width:280px">
          <div class="card-header">
            <span class="card-title">Recent savings</span>
            <a href="/member/passbook" class="btn btn-outline btn-sm">Full passbook</a>
          </div>
          <% if (savings.length === 0) { %>
            <div class="empty-state" style="padding:28px">
              <div class="empty-icon"><i data-lucide="piggy-bank"></i></div>
              <p>No savings recorded yet.</p>
            </div>
          <% } else { %>
            <% savings.forEach((s, si) => { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:<%= si < savings.length-1 ? '1px solid var(--hairline)' : 'none' %>">
              <div>
                <div style="font-size:0.855rem;font-weight:600;color:var(--ink)"><%= months[s.month] %> <%= s.year %></div>
              </div>
              <span style="font-family:var(--font-serif);font-weight:600;color:var(--accent);font-size:0.9rem">+ ₹<%= s.amount.toFixed(2) %></span>
            </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Loans -->
        <div class="card" style="flex:1;min-width:280px">
          <div class="card-header">
            <span class="card-title">My loans</span>
            <a href="/member/loans" class="btn btn-outline btn-sm">View all</a>
          </div>
          <% if (loans.length === 0) { %>
            <div class="empty-state" style="padding:28px">
              <div class="empty-icon"><i data-lucide="credit-card"></i></div>
              <p>No loan applications yet.</p>
              <a href="/member/loans/request" class="btn btn-primary btn-sm">Apply for loan</a>
            </div>
          <% } else { %>
            <% loans.forEach((loan, li) => { %>
            <div style="padding:11px 0;border-bottom:<%= li < loans.length-1 ? '1px solid var(--hairline)' : 'none' %>;display:flex;justify-content:space-between;align-items:center">
              <div>
                <div style="font-size:0.855rem;font-weight:600;color:var(--ink)">₹<%= loan.amount.toLocaleString('en-IN') %></div>
                <div class="text-xs text-muted" style="margin-top:2px"><%= loan.purpose.substring(0,32) %> &middot; <%= loan.tenure %> mo.</div>
              </div>
              <div class="flex items-center gap-2">
                <% if (loan.status === 'pending') { %><span class="badge badge-warning">Pending</span>
                <% } else if (loan.status === 'active') { %><span class="badge badge-success">Active</span>
                <% } else if (loan.status === 'closed') { %><span class="badge badge-secondary">Closed</span>
                <% } else if (loan.status === 'rejected') { %><span class="badge badge-danger">Rejected</span>
                <% } %>
                <a href="/member/loans/<%= loan._id %>" class="btn btn-outline btn-sm"><i data-lucide="arrow-right"></i></a>
              </div>
            </div>
            <% }) %>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
