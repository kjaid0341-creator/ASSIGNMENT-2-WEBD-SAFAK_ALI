<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <div class="top-bar">
      <div>
        <div class="page-title">📋 My Loans</div>
        <div class="breadcrumb">Loan applications & repayment status</div>
      </div>
      <a href="/member/loans/request" class="btn btn-primary btn-sm">➕ New Request</a>
    </div>

    <div class="page-content">
      <%- include('../partials/flash') %>

      <% if (loans.length === 0) { %>
        <div class="card">
          <div class="empty-state">
            <div class="empty-icon">💳</div>
            <h3>No Loan Applications</h3>
            <p>You haven't applied for any loans yet.</p>
            <a href="/member/loans/request" class="btn btn-primary mt-3">Request First Loan</a>
          </div>
        </div>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:20px">
          <% loans.forEach(loan => { %>
          <div class="card">
            <div class="card-header">
              <div>
                <div class="card-title rupee">₹<%= loan.amount.toLocaleString('en-IN') %> — <%= loan.purpose.substring(0,40) %></div>
                <div class="text-xs text-muted mt-1">Applied: <%= moment(loan.appliedAt).format('DD MMM YYYY') %> · Tenure: <%= loan.tenure %> months</div>
              </div>
              <div class="flex items-center gap-2">
                <% if (loan.status === 'pending') { %><span class="badge badge-warning">⏳ Pending Approval</span>
                <% } else if (loan.status === 'active') { %><span class="badge badge-success">✅ Active</span>
                <% } else if (loan.status === 'closed') { %><span class="badge badge-secondary">🔒 Closed</span>
                <% } else if (loan.status === 'rejected') { %><span class="badge badge-danger">❌ Rejected</span>
                <% } %>
                <a href="/member/loans/<%= loan._id %>" class="btn btn-outline btn-sm">View Details →</a>
              </div>
            </div>

            <% if (loan.status === 'active') { %>
            <div class="flex gap-4" style="flex-wrap:wrap">
              <div style="flex:1;min-width:200px">
                <div class="flex justify-between mb-2">
                  <span class="text-xs text-muted">Repayment Progress</span>
                  <span class="text-xs fw-bold"><%= loan.totalRepayable > 0 ? Math.round((loan.totalRepaid / loan.totalRepayable) * 100) : 0 %>%</span>
                </div>
                <div class="progress-bar-wrap">
                  <div class="progress-bar-fill" style="width:<%= loan.totalRepayable > 0 ? Math.round((loan.totalRepaid / loan.totalRepayable) * 100) : 0 %>%"></div>
                </div>
                <div class="flex justify-between mt-2 text-xs">
                  <span class="text-success">Paid: ₹<%= loan.totalRepaid.toFixed(2) %></span>
                  <span class="text-danger">Outstanding: ₹<%= loan.principalOutstanding.toFixed(2) %></span>
                </div>
              </div>
              <div class="flex gap-3">
                <div style="text-align:center;padding:10px 16px;background:var(--bg-card);border-radius:var(--radius-sm)">
                  <div class="text-xs text-muted">EMI</div>
                  <div class="fw-bold text-success rupee">₹<%= loan.instalmentAmount.toFixed(2) %></div>
                </div>
                <div style="text-align:center;padding:10px 16px;background:var(--bg-card);border-radius:var(--radius-sm)">
                  <div class="text-xs text-muted">Paid</div>
                  <div class="fw-bold text-primary-accent">
                    <%= loan.instalmentSchedule.filter(i=>i.status==='paid').length %>/<%= loan.tenure %>
                  </div>
                </div>
                <div style="text-align:center;padding:10px 16px;background:var(--bg-card);border-radius:var(--radius-sm)">
                  <div class="text-xs text-muted">Overdue</div>
                  <div class="fw-bold text-danger">
                    <%= loan.instalmentSchedule.filter(i=>i.status==='overdue').length %>
                  </div>
                </div>
              </div>
            </div>
            <% } else if (loan.status === 'rejected') { %>
            <div class="alert alert-error" style="margin-top:8px">
              <strong>Rejection Reason:</strong> <%= loan.rejectionReason || 'No reason provided' %>
            </div>
            <% } else if (loan.status === 'closed') { %>
            <div class="alert alert-success" style="margin-top:8px">
              ✅ This loan has been fully repaid. Total repaid: ₹<%= loan.totalRepaid.toFixed(2) %>
            </div>
            <% } %>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
