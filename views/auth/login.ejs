<%- include('../partials/header') %>

<div class="auth-page">
  <!-- Left panel -->
  <div class="auth-left">
    <a href="/" class="auth-brand">
      <i data-lucide="landmark"></i>
      SHG Tracker
    </a>
    <div class="auth-panel-body">
      <h2>The group ledger, online.</h2>
      <p>
        Record member savings, approve loan applications, and track repayments — all in one place. No spreadsheets. No paper.
      </p>
      <div class="sample-panel">
        <div class="sample-panel-header">Recent activity — Mahila Udyog SHG</div>
        <div class="sample-row">
          <div><div class="s-name">Anita Devi</div><div class="s-date">Savings · Sep 2024</div></div>
          <div class="s-amt">+ ₹300</div>
        </div>
        <div class="sample-row">
          <div><div class="s-name">Rajkumar M.</div><div class="s-date">Loan approved · ₹12,000</div></div>
          <div style="color:var(--accent);font-size:0.78rem;font-weight:600">Active</div>
        </div>
        <div class="sample-row">
          <div><div class="s-name">Priya Kumari</div><div class="s-date">EMI repaid · Aug 2024</div></div>
          <div style="color:var(--accent);font-size:0.78rem;font-weight:600">Paid</div>
        </div>
      </div>
    </div>
    <div style="font-size:0.72rem;color:var(--ink-3);margin-top:auto">
      SHG Tracker &nbsp;&middot;&nbsp; Community Finance Software &nbsp;&middot;&nbsp; &copy; 2024
    </div>
  </div>

  <!-- Right panel — form -->
  <div class="auth-right">
    <div class="auth-form-wrap">
      <h2 class="auth-heading">Sign in</h2>
      <p class="auth-sub">Enter your registered email and password.</p>

      <%- include('../partials/flash') %>

      <!-- Google OAuth with Role Options -->
      <div class="google-auth-box">
        <label class="google-role-label">Choose role for Google Sign-In:</label>
        <div class="role-selector-pills">
          <button type="button" class="role-pill-btn active" id="pill-admin" data-role="admin">
            <span class="role-pill-badge">Active</span>
            <span class="role-pill-icon">🛡️</span>
            <div class="role-pill-info">
              <span class="role-pill-name">Admin</span>
              <span class="role-pill-sub">Manage SHG & loans</span>
            </div>
          </button>
          <button type="button" class="role-pill-btn" id="pill-member" data-role="member">
            <span class="role-pill-badge">Active</span>
            <span class="role-pill-icon">👤</span>
            <div class="role-pill-info">
              <span class="role-pill-name">Member</span>
              <span class="role-pill-sub">View personal ledger</span>
            </div>
          </button>
        </div>

        <a href="/auth/google?role=admin" class="btn-google" id="btn-google-login">
          <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            <path fill="none" d="M0 0h48v48H0z"/>
          </svg>
          <span id="google-btn-text">Continue with Google as <strong>Admin</strong></span>
        </a>
      </div>

      <div class="auth-divider">or</div>

      <form action="/auth/login" method="POST" id="login-form">
        <div class="form-group">
          <label class="form-label" for="email">Email address</label>
          <input id="email" type="email" name="email" class="form-control" placeholder="name@example.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input id="password" type="password" name="password" class="form-control" placeholder="Your password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary w-100" style="justify-content:center;margin-top:6px">
          Sign in
        </button>
      </form>

      <div class="auth-divider">or</div>
      <p style="font-size:0.83rem;color:var(--ink-3);text-align:center">
        No account? <a href="/auth/register">Register your group</a>
      </p>
    </div>
  </div>
</div>

<script>
  (function() {
    const adminBtn = document.getElementById('pill-admin');
    const memberBtn = document.getElementById('pill-member');
    const googleLink = document.getElementById('btn-google-login');
    const googleText = document.getElementById('google-btn-text');

    function selectRole(role) {
      if (role === 'admin') {
        adminBtn.classList.add('active');
        memberBtn.classList.remove('active');
        googleLink.href = '/auth/google?role=admin';
        googleText.innerHTML = 'Continue with Google as <strong>Admin</strong>';
      } else {
        memberBtn.classList.add('active');
        adminBtn.classList.remove('active');
        googleLink.href = '/auth/google?role=member';
        googleText.innerHTML = 'Continue with Google as <strong>Member</strong>';
      }
    }

    if (adminBtn && memberBtn) {
      adminBtn.addEventListener('click', () => selectRole('admin'));
      memberBtn.addEventListener('click', () => selectRole('member'));
    }

    // Check query params if any (e.g. ?role=member)
    const params = new URLSearchParams(window.location.search);
    if (params.get('role') === 'member') {
      selectRole('member');
    }
  })();
</script>

<%- include('../partials/footer') %>

