<%- include('../partials/header') %>

<div class="auth-page">
  <!-- Left panel -->
  <div class="auth-left">
    <a href="/" class="auth-brand">
      <i data-lucide="landmark"></i>
      SHG Tracker
    </a>
    <div class="auth-panel-body">
      <h2>Start recording. No setup cost.</h2>
      <p>
        Register as a group admin to create your SHG, add members, and begin recording savings immediately. Members can self-register and link to your group.
      </p>
      <div class="sample-panel" style="margin-top:0">
        <div class="sample-panel-header">Interest — simple calculation</div>
        <div class="sample-row">
          <div class="s-name">Principal</div>
          <div style="font-size:0.82rem;font-weight:600;color:var(--ink)">₹15,000</div>
        </div>
        <div class="sample-row">
          <div class="s-name">Rate · 12% p.a.</div>
          <div style="font-size:0.82rem;font-weight:600;color:var(--ink)">12 months</div>
        </div>
        <div class="sample-row">
          <div class="s-name">Total interest</div>
          <div style="font-size:0.82rem;font-weight:600;color:var(--warning-clr)">₹1,800</div>
        </div>
        <div class="sample-row">
          <div class="s-name">Monthly EMI</div>
          <div style="font-size:0.92rem;font-weight:600;color:var(--accent);font-family:var(--font-serif)">₹1,400</div>
        </div>
      </div>
      <p style="font-size:0.78rem;color:var(--ink-3);max-width:none;margin-top:10px">
        I = P &times; R &times; T &divide; 100. Schedule auto-generated on loan approval.
      </p>
    </div>
    <div style="font-size:0.72rem;color:var(--ink-3);margin-top:auto">
      SHG Tracker &nbsp;&middot;&nbsp; Community Finance Software &nbsp;&middot;&nbsp; &copy; 2024
    </div>
  </div>

  <!-- Right panel — form -->
  <div class="auth-right">
    <div class="auth-form-wrap" style="max-width:400px">
      <h2 class="auth-heading">Create account</h2>
      <p class="auth-sub">Register as a group admin or member.</p>

      <%- include('../partials/flash') %>

      <!-- Google OAuth with Role Options -->
      <div class="google-auth-box">
        <label class="google-role-label">Choose role for Google Sign-Up:</label>
        <div class="role-selector-pills">
          <button type="button" class="role-pill-btn active" id="reg-pill-admin" data-role="admin">
            <span class="role-pill-badge">Active</span>
            <span class="role-pill-icon">🛡️</span>
            <div class="role-pill-info">
              <span class="role-pill-name">Admin</span>
              <span class="role-pill-sub">Manage SHG & loans</span>
            </div>
          </button>
          <button type="button" class="role-pill-btn" id="reg-pill-member" data-role="member">
            <span class="role-pill-badge">Active</span>
            <span class="role-pill-icon">👤</span>
            <div class="role-pill-info">
              <span class="role-pill-name">Member</span>
              <span class="role-pill-sub">View personal ledger</span>
            </div>
          </button>
        </div>

        <a href="/auth/google?role=admin" class="btn-google" id="btn-google-register">
          <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            <path fill="none" d="M0 0h48v48H0z"/>
          </svg>
          <span id="google-reg-text">Continue with Google as <strong>Admin</strong></span>
        </a>
      </div>

      <div class="auth-divider">or sign up with email</div>

      <form action="/auth/register" method="POST" id="register-form">
        <div class="form-group">
          <label class="form-label" for="name">Full Name *</label>
          <input id="name" type="text" name="name" class="form-control" placeholder="Zaid Ali" required>
        </div>

        <!-- Mobile with inline Send OTP button -->
        <div class="form-group">
          <label class="form-label" for="phone">Mobile *</label>
          <div class="input-with-action" id="mobile-wrap">
            <span class="prefix-badge">+91</span>
            <input 
              id="phone" 
              type="tel" 
              name="phone" 
              class="input-action-field" 
              placeholder="6394524398" 
              maxlength="10" 
              required
            >
            <button type="button" class="btn-inline-action" id="btn-send-otp">Send OTP</button>
            <span class="verified-badge-inline" id="phone-verified-badge" style="display:none">✓ Verified</span>
          </div>
        </div>

        <!-- Mobile OTP with inline Verify button (reveals on Send OTP) -->
        <div class="form-group" id="otp-group" style="display:none">
          <label class="form-label" for="input-otp">Mobile OTP *</label>
          <div class="input-with-action" id="otp-wrap">
            <input 
              id="input-otp" 
              type="text" 
              inputmode="numeric" 
              class="input-action-field" 
              placeholder="Enter 5-digit OTP" 
              maxlength="5"
            >
            <button type="button" class="btn-inline-action btn-verify" id="btn-verify-otp">Verify</button>
          </div>
          <div class="otp-subtext" id="otp-timer-wrap">
            Didn't receive OTP? <span class="countdown-highlight" id="otp-countdown-text">Resend in <span id="otp-timer">30</span>s</span>
            <span class="resend-link" id="btn-resend-link" style="display:none">Resend OTP</span>
          </div>
          <div id="otp-msg-banner" style="display:none;margin-top:6px;font-size:0.8rem;border-radius:6px;padding:6px 10px;"></div>
        </div>

        <input type="hidden" name="phoneVerified" id="is-phone-verified" value="false">

        <div class="form-group">
          <label class="form-label" for="reg-email">Email *</label>
          <input id="reg-email" type="email" name="email" class="form-control" placeholder="za165338@gmail.com" required autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label" for="role">Register as *</label>
          <select id="role" name="role" class="form-control" required>
            <option value="">-- Select role --</option>
            <option value="admin">Group Admin / Leader</option>
            <option value="member">Member</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="address">Village / District</label>
          <input id="address" type="text" name="address" class="form-control" placeholder="e.g. Rampur, Sitapur, UP">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="reg-password">Password *</label>
            <input id="reg-password" type="password" name="password" class="form-control" placeholder="Min. 6 characters" required autocomplete="new-password">
          </div>
          <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm *</label>
            <input id="confirmPassword" type="password" name="confirmPassword" class="form-control" placeholder="Repeat" required>
          </div>
        </div>

        <div class="form-group" style="display:flex;align-items:center;gap:8px;margin-top:8px">
          <input type="checkbox" id="terms" required checked>
          <label for="terms" style="font-size:0.78rem;color:var(--ink-2);cursor:pointer;margin:0">
            I agree to <span style="color:#e53935">Terms & Conditions</span> & <span style="color:#e53935">Privacy Policy</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary w-100" id="btn-submit-signup" style="justify-content:center;margin-top:10px">
          Create account
        </button>
      </form>

      <div class="auth-divider">or</div>
      <p style="font-size:0.83rem;color:var(--ink-3);text-align:center">
        Already registered? <a href="/auth/login">Sign in</a>
      </p>
    </div>
  </div>
</div>

<script>
  (function() {
    const adminBtn = document.getElementById('reg-pill-admin');
    const memberBtn = document.getElementById('reg-pill-member');
    const googleLink = document.getElementById('btn-google-register');
    const googleText = document.getElementById('google-reg-text');
    const formRoleSelect = document.getElementById('role');

    function selectRole(role) {
      if (role === 'admin') {
        adminBtn.classList.add('active');
        memberBtn.classList.remove('active');
        googleLink.href = '/auth/google?role=admin';
        googleText.innerHTML = 'Continue with Google as <strong>Admin</strong>';
        if (formRoleSelect && !formRoleSelect.value) {
          formRoleSelect.value = 'admin';
        }
      } else {
        memberBtn.classList.add('active');
        adminBtn.classList.remove('active');
        googleLink.href = '/auth/google?role=member';
        googleText.innerHTML = 'Continue with Google as <strong>Member</strong>';
        if (formRoleSelect && !formRoleSelect.value) {
          formRoleSelect.value = 'member';
        }
      }
    }

    if (adminBtn && memberBtn) {
      adminBtn.addEventListener('click', () => selectRole('admin'));
      memberBtn.addEventListener('click', () => selectRole('member'));
    }

    // Check query params if any (e.g. ?role=member)
    const params = new URLSearchParams(window.location.search);
    if (params.get('role') === 'member') {
      selectRole('member');
    }

    // ─── Inline Phone & OTP Verification Logic ────────────────────────
    const phoneInput = document.getElementById('phone');
    const btnSendOtp = document.getElementById('btn-send-otp');
    const otpGroup = document.getElementById('otp-group');
    const inputOtp = document.getElementById('input-otp');
    const btnVerifyOtp = document.getElementById('btn-verify-otp');
    const phoneVerifiedBadge = document.getElementById('phone-verified-badge');
    const mobileWrap = document.getElementById('mobile-wrap');
    const otpMsgBanner = document.getElementById('otp-msg-banner');
    const isPhoneVerifiedInput = document.getElementById('is-phone-verified');
    const otpTimer = document.getElementById('otp-timer');
    const otpCountdownText = document.getElementById('otp-countdown-text');
    const btnResendLink = document.getElementById('btn-resend-link');
    const registerForm = document.getElementById('register-form');

    let countdownInterval = null;

    function startTimer(seconds) {
      let remaining = seconds;
      otpTimer.textContent = remaining;
      otpCountdownText.style.display = 'inline';
      btnResendLink.style.display = 'none';

      if (countdownInterval) clearInterval(countdownInterval);

      countdownInterval = setInterval(() => {
        remaining--;
        otpTimer.textContent = remaining;
        if (remaining <= 0) {
          clearInterval(countdownInterval);
          otpCountdownText.style.display = 'none';
          btnResendLink.style.display = 'inline';
        }
      }, 1000);
    }

    async function handleSendOtp() {
      const phone = phoneInput.value.replace(/\D/g, '');
      if (phone.length !== 10) {
        alert('Please enter a valid 10-digit mobile phone number.');
        phoneInput.focus();
        return;
      }

      btnSendOtp.disabled = true;
      btnSendOtp.textContent = 'Sending...';
      otpMsgBanner.style.display = 'none';

      try {
        const res = await fetch('/auth/api/send-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone })
        });
        const data = await res.json();

        if (data.success) {
          otpGroup.style.display = 'block';
          btnSendOtp.textContent = 'Resend';
          btnSendOtp.disabled = true;
          startTimer(30);
          inputOtp.focus();

          if (data.demoOtp) {
            otpMsgBanner.style.display = 'block';
            otpMsgBanner.style.background = '#eaf5ee';
            otpMsgBanner.style.border = '1px dashed #2d8a5e';
            otpMsgBanner.style.color = '#164e3a';
            otpMsgBanner.innerHTML = `💡 <strong>Demo Preview:</strong> Your 5-digit OTP is <strong>${data.demoOtp}</strong>`;
          } else {
            otpMsgBanner.style.display = 'block';
            otpMsgBanner.style.background = '#e8f5e9';
            otpMsgBanner.style.border = '1px solid #c8e6c9';
            otpMsgBanner.style.color = '#2e7d32';
            otpMsgBanner.innerHTML = `✓ Real SMS sent to +91 ${phone}`;
          }
        } else {
          alert(data.message || 'Failed to send OTP.');
          btnSendOtp.disabled = false;
          btnSendOtp.textContent = 'Send OTP';
        }
      } catch (err) {
        alert('Network error sending OTP. Please try again.');
        btnSendOtp.disabled = false;
        btnSendOtp.textContent = 'Send OTP';
      }
    }

    btnSendOtp.addEventListener('click', handleSendOtp);
    btnResendLink.addEventListener('click', handleSendOtp);

    btnVerifyOtp.addEventListener('click', async () => {
      const phone = phoneInput.value.replace(/\D/g, '');
      const otp = inputOtp.value.trim();

      if (otp.length !== 5) {
        alert('Please enter the 5-digit OTP code.');
        inputOtp.focus();
        return;
      }

      btnVerifyOtp.disabled = true;
      btnVerifyOtp.textContent = 'Verifying...';

      try {
        const res = await fetch('/auth/api/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, otp })
        });
        const data = await res.json();

        if (data.success) {
          isPhoneVerifiedInput.value = 'true';
          phoneInput.readOnly = true;
          btnSendOtp.style.display = 'none';
          phoneVerifiedBadge.style.display = 'inline-flex';
          mobileWrap.classList.add('is-verified');

          otpMsgBanner.style.display = 'block';
          otpMsgBanner.style.background = '#e8f5e9';
          otpMsgBanner.style.border = '1px solid #2e7d32';
          otpMsgBanner.style.color = '#2e7d32';
          otpMsgBanner.innerHTML = '✓ Mobile number verified successfully!';
          btnVerifyOtp.textContent = 'Verified ✓';
          inputOtp.readOnly = true;
          if (countdownInterval) clearInterval(countdownInterval);
          document.getElementById('otp-timer-wrap').style.display = 'none';
        } else {
          alert(data.message || 'Invalid OTP code.');
          btnVerifyOtp.disabled = false;
          btnVerifyOtp.textContent = 'Verify';
        }
      } catch (err) {
        alert('Verification error. Please try again.');
        btnVerifyOtp.disabled = false;
        btnVerifyOtp.textContent = 'Verify';
      }
    });

    registerForm.addEventListener('submit', (e) => {
      if (isPhoneVerifiedInput.value !== 'true') {
        e.preventDefault();
        alert('Please verify your mobile phone number with the 5-digit OTP before continuing.');
        if (otpGroup.style.display === 'none') {
          handleSendOtp();
        } else {
          inputOtp.focus();
        }
      }
    });
  })();
</script>

<%- include('../partials/footer') %>
